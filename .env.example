# Copy of the keys every environment file needs (.env.dev, .env.prod, .env.test).
# Vite inlines VITE_* variables into the JavaScript bundle at build time: never put a secret here.
VITE_APPLICATION_NAME=web
# test | dev | prod
VITE_APPLICATION_ENVIRONMENT=dev
# Optional: "true" shows the account entry points (sign in, sign up). Off when not set.
# VITE_ACCOUNT_ENABLED=true
# Optional: what answers the account screens. "unavailable" (default): every action fails with
# "not available yet". "preview": an in-memory fake with a sample user, for local preview and
# tests only. A production build with "preview" fails.
# VITE_AUTH_GATEWAY=preview
