# Copy of the keys every environment file needs (.env.dev, .env.prod, .env.test).
# Vite inlines VITE_* variables into the JavaScript bundle at build time: never put a secret here.
VITE_APPLICATION_NAME=web
# test | dev | prod
VITE_APPLICATION_ENVIRONMENT=dev
# Optional: "true" shows the account entry points (sign in, sign up). Off when not set.
# VITE_ACCOUNT_ENABLED=true
# Optional: what answers the account screens. "unavailable" (default): every action fails with
# "not available yet". "preview": an in-memory fake with a sample user, for local preview and
# tests only. A production build with "preview" fails. "firebase": Firebase Authentication and
# Firestore; it needs the four VITE_FIREBASE_* values below, and it is used only while
# VITE_ACCOUNT_ENABLED is "true" (otherwise the Firebase code is left out of the build).
# VITE_AUTH_GATEWAY=preview
# Required with VITE_AUTH_GATEWAY=firebase: the settings of the project's web app (Firebase
# console, Project settings, Your apps). They are public identifiers, not secrets: what protects
# the data is the Firestore rules and the authorised domains, not hiding these values.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
# Optional, never in production: "true" sends the Firebase gateway to the local emulators of
# quadev-backend (Auth on 127.0.0.1:9099, Firestore on 127.0.0.1:8080) instead of a real project.
# VITE_USE_FIREBASE_EMULATORS=true
