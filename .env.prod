# Production configuration (yarn build, yarn start:prod). This is what quadev.net is built with.
# Public values only: Vite inlines them into the bundle.
VITE_APPLICATION_NAME=web
VITE_APPLICATION_ENVIRONMENT=prod
# THE PRODUCTION SWITCH. "false": the account pages do not exist for visitors (their addresses show
# "Page not found") and the build has no Firebase code.
# To enable accounts on quadev.net, set VITE_ACCOUNT_ENABLED to "true" and release a version tag.
# First go through "Enabling accounts in production" in the README.
VITE_ACCOUNT_ENABLED=false
VITE_AUTH_GATEWAY=firebase
# Settings of the web app "QuaDev website" in quadevapp, ready for the switch. Public identifiers,
# not secrets. They are not used while the switch is off.
VITE_FIREBASE_API_KEY=AIzaSyDP9xMCMMDjj60t6wgneDFM-NLnRgKKSe4
VITE_FIREBASE_AUTH_DOMAIN=quadevapp.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=quadevapp
VITE_FIREBASE_APP_ID=1:993625301555:web:abd36ce85ec6b48b787946
