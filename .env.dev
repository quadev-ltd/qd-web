# Development configuration (yarn start:dev). Public values only: Vite inlines them into the bundle.
VITE_APPLICATION_NAME=web
VITE_APPLICATION_ENVIRONMENT=dev
# To preview the account entry points, run `VITE_ACCOUNT_ENABLED=true yarn start:dev`
# or put the line in .env.dev.local (not committed).
VITE_ACCOUNT_ENABLED=false
# With the account entry points on, the forms work against an in-memory fake (sample user in
# the README). Allowed in development only: a production build with "preview" fails.
VITE_AUTH_GATEWAY=preview
