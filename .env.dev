# Development configuration (yarn start:dev, and the build deployed to dev.quadev.net).
# Public values only: Vite inlines them into the bundle.
VITE_APPLICATION_NAME=web
VITE_APPLICATION_ENVIRONMENT=dev
# The account pages are on in development and talk to the dev Firebase project (quadevapp-dev).
VITE_ACCOUNT_ENABLED=true
# "firebase": Firebase Authentication and Firestore of the project below.
# To work without a backend, put VITE_AUTH_GATEWAY=preview in .env.dev.local (not committed): the
# forms then use an in-memory fake (sample user in the README). For the local emulators, put
# VITE_USE_FIREBASE_EMULATORS=true there instead.
VITE_AUTH_GATEWAY=firebase
# Settings of the web app "QuaDev website (dev)" in quadevapp-dev. They are public identifiers, not
# secrets: every visitor's browser receives them. Access is decided by the Firestore rules and by
# the authorised domains of Firebase Authentication.
VITE_FIREBASE_API_KEY=AIzaSyAcZkXGJy07zS_3p7KymJAI2Q8dWu_tu2Q
VITE_FIREBASE_AUTH_DOMAIN=quadevapp-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=quadevapp-dev
VITE_FIREBASE_APP_ID=1:476492543939:web:02d0ac990fb5c987a66f76
# The default Cloud Storage bucket of quadevapp-dev: where the files of the interview profile are
# uploaded. A public identifier; the bucket's rules decide who may write and read.
VITE_FIREBASE_STORAGE_BUCKET=quadevapp-dev.firebasestorage.app
# App Check: the site key of the reCAPTCHA Enterprise key "QuaDev-Dev Captcha" in quadevapp-dev,
# registered for the web app above in the Firebase console (App Check). A public identifier: the key
# only works on dev.quadev.net. The backend's functions refuse calls without App Check.
# On your own machine reCAPTCHA does not answer: put VITE_APPCHECK_DEBUG_TOKEN=<your debug token> in
# .env.dev.local (not committed; the token is a secret, see the README).
VITE_RECAPTCHA_SITE_KEY=6LdhBewtAAAAABK44K1S89k_Rqs34FKDe_yDxcWK
